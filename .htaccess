# Hostinger's default MIME map has no entry for .m4a and falls back to
# text/plain. That mislabeling makes the server gzip the file, and a
# compressed response cannot serve byte ranges -- which silently breaks
# seeking in the audio player and in podcast clients.
<IfModule mod_mime.c>
  AddType audio/mp4 .m4a
  AddType audio/mp4 .m4b
</IfModule>

# Belt and braces: never compress audio, regardless of how it is typed.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI \.(m4a|m4b|mp3|aac)$ no-gzip dont-vary
</IfModule>

# Temporary deployment probe: /htaccess-probe returns 302 only if this file
# is being read by the server. Remove once MIME handling is confirmed.
<IfModule mod_alias.c>
  Redirect 302 /htaccess-probe /
</IfModule>
