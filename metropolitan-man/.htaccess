Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# Run the release check even when a guessed filename looks like static media.
RewriteRule ^(?:data/.*|media/.*|feed(?:-opus)?\.xml)$ release.php [END]
<Files "release.php">
    # The PHP handler sets cache policy after the release check.
    Header set X-Content-Type-Options "nosniff"
</Files>
SetEnv no-gzip 1
# A stale worker can disagree with the content-hashed reader JS after a release.
# This rule affects only the update script, never audio or the offline stores.
<Files "offline-worker.js">
    Header always set Cache-Control "no-store, max-age=0"
    Header always set CDN-Cache-Control "no-store"
    Header always set LiteSpeed-Cache-Control "no-cache"
</Files>
