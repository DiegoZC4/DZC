Options -Indexes
DirectoryIndex index.html
RewriteEngine On
# Run the release check even when a guessed filename looks like static media.
RewriteRule ^(?:data/.*|media/.*|feed(?:-opus)?\.xml)$ release.php [END]
<Files "release.php">
    # The PHP handler sets cache policy after the release check.
    Header set X-Content-Type-Options "nosniff"
</Files>
SetEnv no-gzip 1
# Keep unversioned entry points out of intermediary/native HTTP caches. Offline
# reopening uses the explicitly saved, coherent Cache Storage bundle instead.
# Content-hashed scripts/styles and all media retain their usual cache policy.
<FilesMatch "^(index\.html|offline-worker\.js)$">
    Header always set Cache-Control "no-store, max-age=0"
    Header always set CDN-Cache-Control "no-store"
    Header always set LiteSpeed-Cache-Control "no-cache"
</FilesMatch>
