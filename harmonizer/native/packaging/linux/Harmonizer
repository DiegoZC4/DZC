#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
support="${XDG_DATA_HOME:-$HOME/.local/share}/Harmonizer"
port="${HARMONIZER_WEB_PORT:-8794}"
url="http://127.0.0.1:$port/"

mkdir -p "$support/web"
cp "$root/web/index.html" "$support/web/index.html"
cd "$support"

"$root/harmonizer_web" --port "$port" >> "$support/harmonizer.log" 2>&1 &
server_pid=$!
cleanup() {
  if kill -0 "$server_pid" 2>/dev/null; then kill "$server_pid" 2>/dev/null || true; fi
}
trap cleanup INT TERM EXIT

for _attempt in $(seq 1 60); do
  if curl --fail --silent "$url"health >/dev/null 2>&1; then
    if [[ "$(uname -s)" == "Darwin" ]]; then open "$url"; else xdg-open "$url"; fi
    wait "$server_pid"
    exit $?
  fi
  sleep 0.1
done

printf 'Harmonizer did not start. See %s\n' "$support/harmonizer.log" >&2
exit 1
